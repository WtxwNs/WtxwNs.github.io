---
import type { Lang } from '@/data/navigation';
interface Props { headings?: { depth: number; slug: string; text: string }[]; lang: Lang }
const { headings = [], lang } = Astro.props;
const visible = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{visible.length > 0 && (
  <details class="mb-6 border-l border-[var(--line)] pl-4 text-sm">
    <summary class="cursor-pointer font-medium">{lang === 'zh' ? '文章目录' : 'Contents'}</summary>
    <ol class="mt-3 space-y-2 text-[var(--muted)]">
      {visible.map((h) => <li class={h.depth === 3 ? 'pl-3' : ''}><a href={`#${h.slug}`}>{h.text}</a></li>)}
    </ol>
  </details>
)}
