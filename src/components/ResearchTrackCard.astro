---
import type { Lang } from '@/data/navigation';

interface Props {
  index: string;
  title: string;
  titleZh?: string;
  question: string;
  questionZh?: string;
  description: string;
  descriptionZh?: string;
  works: string[];
  lang?: Lang;
}

const { title, titleZh, question, questionZh, description, descriptionZh, works, lang = 'en' } = Astro.props;
const displayTitle = lang === 'zh' ? titleZh ?? title : title;
const displayQuestion = lang === 'zh' ? questionZh ?? question : question;
const displayDescription = lang === 'zh' ? descriptionZh ?? description : description;
---

<article class="border-t border-[var(--line)] py-5">
      <h3 class="font-serif text-xl font-semibold">{displayTitle}</h3>
      <p class="mt-3 text-base font-medium leading-relaxed text-[var(--text)]">{displayQuestion}</p>
      <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">{displayDescription}</p>
      <p class="mt-2 text-sm text-[var(--muted)]">
        {works.join(' · ')}
      </p>
</article>
