---
import type { Lang } from '@/data/navigation';

interface Props {
  index: string;
  title: string;
  titleZh?: string;
  question: string;
  questionZh?: string;
  description: string;
  descriptionZh?: string;
  works: string[];
  lang?: Lang;
}

const { index, title, titleZh, question, questionZh, description, descriptionZh, works, lang = 'en' } = Astro.props;
const displayTitle = lang === 'zh' ? titleZh ?? title : title;
const displayQuestion = lang === 'zh' ? questionZh ?? question : question;
const displayDescription = lang === 'zh' ? descriptionZh ?? description : description;
---

<article class="group border-t border-[var(--line)] py-6 transition hover:border-[var(--accent)]">
  <div class="flex items-start gap-4">
    <span class="mt-1 font-mono text-xs font-semibold text-[var(--accent)]">{index}</span>
    <div>
      <h3 class="font-serif text-2xl font-semibold text-[var(--text)]">{displayTitle}</h3>
      <p class="mt-3 text-base font-medium leading-relaxed text-[var(--text)]">{displayQuestion}</p>
      <p class="mt-2 text-sm leading-relaxed text-[var(--muted)]">{displayDescription}</p>
      <p class="mt-4 text-xs font-semibold uppercase tracking-[0.12em] text-[var(--accent)]">
        {works.join(' · ')}
      </p>
    </div>
  </div>
</article>
