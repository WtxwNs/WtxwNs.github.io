---
interface Props {
  post: {
    slug: string;
    data: { title: string; description: string; date: Date; category: string; tags: string[] };
  };
  lang: 'en' | 'zh';
}
const { post, lang } = Astro.props;
---
<article class="rounded-lg border border-[var(--line)] bg-[var(--panel)] p-5 transition hover:border-[var(--accent)]">
  <p class="text-sm font-semibold text-[var(--accent)]">{post.data.category} · {post.data.date.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US')}</p>
  <h3 class="mt-1 font-serif text-2xl font-semibold text-[var(--text)]"><a href={`/${lang}/blog/${post.slug}`}>{post.data.title}</a></h3>
  <p class="mt-2 text-sm text-[var(--muted)]">{post.data.description}</p>
  <p class="mt-3 text-xs text-[var(--muted)]">{post.data.tags.join(' · ')}</p>
</article>
