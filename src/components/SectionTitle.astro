---
interface Props {
  page?: boolean;
  title: string;
  description?: string;
}
const { page = false, title, description } = Astro.props;
const Heading = page ? 'h1' : 'h2';
---

<div class="mb-6">
  <Heading class:list={['font-serif font-semibold leading-snug', page ? 'text-3xl' : 'text-2xl']}>{title}</Heading>
  {description && <p class="mt-3 max-w-3xl text-[var(--muted)]">{description}</p>}
</div>
