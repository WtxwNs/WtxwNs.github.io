---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="mb-6">
  {eyebrow && <p class="mb-2 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">{eyebrow}</p>}
  <h2 class="font-serif text-3xl font-semibold leading-tight text-[var(--text)] sm:text-4xl">{title}</h2>
  {description && <p class="mt-3 max-w-3xl text-[var(--muted)]">{description}</p>}
</div>
