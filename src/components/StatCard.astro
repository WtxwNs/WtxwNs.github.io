---
interface Props { label: string; value: string | number; hint?: string }
const { label, value, hint } = Astro.props;
---
<div class="rounded-lg border border-[var(--line)] bg-[var(--panel)] p-4 shadow-soft">
  <p class="text-3xl font-semibold text-[var(--text)]">{value}</p>
  <p class="mt-1 text-sm font-medium text-[var(--muted)]">{label}</p>
  {hint && <p class="mt-2 text-xs text-[var(--muted)]">{hint}</p>}
</div>
