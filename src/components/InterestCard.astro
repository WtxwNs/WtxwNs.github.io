---
import type { Lang } from '@/data/navigation';
interface Props {
  title: string;
  titleZh?: string;
  description: string;
  descriptionZh?: string;
  lang?: Lang;
}
const { title, titleZh, description, descriptionZh, lang = 'en' } = Astro.props;
const displayTitle = lang === 'zh' ? titleZh ?? title : title;
const displayDescription = lang === 'zh' ? descriptionZh ?? description : description;
---
<article class="rounded-lg border border-[var(--line)] bg-[var(--panel)] p-5 transition hover:-translate-y-0.5 hover:border-[var(--accent)] hover:shadow-soft">
  <h3 class="font-serif text-xl font-semibold text-[var(--text)]">{displayTitle}</h3>
  <p class="mt-2 text-sm text-[var(--muted)]">{displayDescription}</p>
</article>
