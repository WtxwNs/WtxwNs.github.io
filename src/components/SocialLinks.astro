---
import { copy, siteConfig } from '@/data/profile';
import { localizedPath, type Lang } from '@/data/navigation';
interface Props { lang: Lang }
const { lang } = Astro.props;
const labels = copy[lang];
const cvHref = siteConfig.hasPublicPdfCv ? '/cv.pdf' : localizedPath(lang, 'cv');
---
<div class="flex flex-wrap items-baseline gap-x-5 gap-y-2 text-sm">
  <a class="text-link" href={`mailto:${siteConfig.email}`}>{labels.ctaEmail}</a>
  <a class="text-link" href={siteConfig.scholar}>Google Scholar</a>
  <a class="text-link" href={siteConfig.github}>GitHub</a>
  <a class="text-link" href={cvHref}>{labels.ctaCv}</a>
</div>
