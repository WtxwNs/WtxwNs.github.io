---
import { localizedPath, type Lang } from '@/data/navigation';

interface Props {
  lang: Lang;
  pathname: string;
}

const { lang, pathname } = Astro.props;
const other = lang === 'en' ? 'zh' : 'en';
const withoutLang = pathname.replace(/^\/(en|zh)/, '').replace(/^\//, '');
const targetPath = /^blog\/.+/.test(withoutLang) && withoutLang !== 'blog/' ? 'blog' : withoutLang;
---

<a
  href={localizedPath(other, targetPath)}
  class="inline-flex h-10 items-center rounded-md border border-[var(--line)] bg-[var(--panel)] px-3 text-sm text-[var(--muted)] transition hover:border-[var(--accent)] hover:text-[var(--text)]"
  aria-label={`Switch language to ${other}`}
>
  {other.toUpperCase()}
</a>
