---
import type { Lang } from '@/data/navigation';
interface Item {
  school?: string;
  schoolZh?: string;
  degree?: string;
  degreeZh?: string;
  period: string;
  periodZh?: string;
  detail?: string;
  detailZh?: string;
}
interface Props { items: Item[]; lang?: Lang }
const { items, lang = 'en' } = Astro.props;
---
<ol class="space-y-4">
  {items.map((item) => (
    <li class="rounded-lg border border-[var(--line)] bg-[var(--panel)] p-4">
      <p class="text-sm font-semibold text-[var(--accent)]">{lang === 'zh' ? item.periodZh ?? item.period : item.period}</p>
      <h3 class="font-serif text-xl font-semibold text-[var(--text)]">{lang === 'zh' ? item.schoolZh ?? item.school : item.school}</h3>
      <p class="text-sm font-medium text-[var(--text)]">{lang === 'zh' ? item.degreeZh ?? item.degree : item.degree}</p>
      {(lang === 'zh' ? item.detailZh ?? item.detail : item.detail) && <p class="mt-2 text-sm text-[var(--muted)]">{lang === 'zh' ? item.detailZh ?? item.detail : item.detail}</p>}
    </li>
  ))}
</ol>
