---
import { siteConfig } from '@/data/profile';
import type { Lang } from '@/data/navigation';
interface Props { lang: Lang }
const { lang } = Astro.props;
---

<footer class="mt-16 flex flex-wrap items-baseline justify-between gap-4 border-t border-[var(--line)] py-5 text-sm text-[var(--muted)]">
  <p>© {new Date().getFullYear()} {lang === 'zh' ? siteConfig.nameZh : siteConfig.name}</p>
  <div class="flex flex-wrap gap-4">
    <a href={`mailto:${siteConfig.email}`} class="hover:underline">{lang === 'zh' ? '联系' : 'Contact'}</a>
    <a href="/manage/" class="hover:underline">{lang === 'zh' ? '管理内容' : 'Manage content'}</a>
  </div>
</footer>
