---
import { siteConfig } from '@/data/profile';
import type { Lang } from '@/data/navigation';
interface Props { lang: Lang }
const { lang } = Astro.props;
---

<footer class="border-t border-[var(--line)]">
  <div class="mx-auto flex max-w-6xl flex-col gap-5 px-4 py-10 text-sm text-[var(--muted)] sm:px-6 lg:px-8 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="font-serif text-lg font-semibold text-[var(--text)]">{siteConfig.name} / {siteConfig.nameZh}</p>
      <p class="mt-1">{lang === 'zh' ? `${siteConfig.institutionZh} · ${siteConfig.locationZh}` : `${siteConfig.institution} · ${siteConfig.location}`}</p>
      <p class="mt-3">© {new Date().getFullYear()} {siteConfig.name}</p>
    </div>
    <div class="flex flex-wrap gap-4 font-semibold text-[var(--text)]">
      <a href={`mailto:${siteConfig.email}`} class="hover:text-[var(--accent)]">Email</a>
      <a href={siteConfig.scholar} class="hover:text-[var(--accent)]">Scholar</a>
      <a href={siteConfig.github} class="hover:text-[var(--accent)]">GitHub</a>
    </div>
  </div>
</footer>
