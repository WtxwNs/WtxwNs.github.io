---
import Tag from './Tag.astro';
import type { Lang } from '@/data/navigation';

interface Props {
  pub: {
    slug?: string;
    data: {
      title: string;
      titleZh?: string;
      authors: string[];
      authorNote?: string;
      authorNoteZh?: string;
      venue: string;
      year: number;
      status: string;
      tags: string[];
      tldr: string;
      tldrZh?: string;
      contributions: string[];
      contributionsZh?: string[];
      links: Record<string, string | null>;
      bibtex?: string;
    };
  };
  compact?: boolean;
  lang?: Lang;
}

const { pub, compact = false, lang = 'en' } = Astro.props;
const d = pub.data;
const tldr = lang === 'zh' ? d.tldrZh ?? d.tldr : d.tldr;
const contributions = lang === 'zh' ? d.contributionsZh ?? d.contributions : d.contributions;
const authorNote = lang === 'zh' ? d.authorNoteZh ?? d.authorNote : d.authorNote;
const linkOrder = ['arxiv', 'pdf', 'code', 'project', 'demo'];
const validLinks = linkOrder
  .map((key) => [key, d.links[key]] as const)
  .filter(([, href]) => typeof href === 'string' && href.length > 0 && !href.startsWith('#todo'));
---
<article class="rounded-lg border border-[var(--line)] bg-[var(--panel)] p-5 shadow-soft">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-sm font-semibold text-[var(--accent)]">{d.year} · {d.venue}</p>
      <h3 class="mt-1 font-serif text-2xl font-semibold leading-tight text-[var(--text)]">{d.title}</h3>
    </div>
    <span class="rounded-full bg-[var(--accent)]/10 px-3 py-1 text-xs font-semibold text-[var(--accent)]">{d.status}</span>
  </div>
  <p class="mt-3 text-sm text-[var(--muted)]">
    {d.authors.map((author, index) => (
      <>
        {author === 'Tongxi Wang' ? <strong class="font-semibold text-[var(--text)]">{author}</strong> : author}
        {index < d.authors.length - 1 ? ', ' : ''}
      </>
    ))}
    {authorNote ? ` · ${authorNote}` : ''}
  </p>
  <p class="mt-3 text-[var(--text)]">{tldr}</p>
  {!compact && (
    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-[var(--muted)]">
      {contributions.map((item) => <li>{item}</li>)}
    </ul>
  )}
  <div class="mt-4 flex flex-wrap gap-2">{d.tags.map((tag) => <Tag label={tag} />)}</div>
  {validLinks.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-3 text-sm font-semibold text-[var(--accent)]">
      {validLinks.map(([label, href]) => <a href={href}>{label === 'arxiv' ? 'arXiv' : label.toUpperCase()}</a>)}
    </div>
  )}
  {!compact && d.bibtex && (
    <details class="mt-4 rounded-md border border-[var(--line)] p-3 text-sm text-[var(--muted)]">
      <summary class="cursor-pointer font-semibold text-[var(--text)]">BibTeX</summary>
      <pre class="mt-3 overflow-x-auto text-xs">{d.bibtex}</pre>
    </details>
  )}
</article>
