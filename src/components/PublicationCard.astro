---
import type { Lang } from '@/data/navigation';

interface Props {
  pub: {
    slug?: string;
    data: {
      title: string;
      titleZh?: string;
      authors: string[];
      authorNote?: string;
      authorNoteZh?: string;
      venue: string;
      year: number;
      status: string;
      tags: string[];
      tldr: string;
      tldrZh?: string;
      contributions: string[];
      contributionsZh?: string[];
      links: Record<string, string | null>;
      bibtex?: string;
    };
  };
  compact?: boolean;
  lang?: Lang;
}

const { pub, compact = false, lang = 'en' } = Astro.props;
const d = pub.data;
const tldr = lang === 'zh' ? d.tldrZh ?? d.tldr : d.tldr;
const contributions = lang === 'zh' ? d.contributionsZh ?? d.contributions : d.contributions;
const linkOrder = ['arxiv', 'pdf', 'code', 'project', 'demo'];
const validLinks = linkOrder
  .map((key) => [key, d.links[key]] as const)
  .filter(([, href]) => typeof href === 'string' && href.length > 0 && !href.startsWith('#todo'));
---
<article class:list={[
  'group border-t border-[var(--line)] transition hover:border-[var(--accent)]',
  compact ? 'py-6' : 'py-7'
]}>
  <div class="grid gap-4 md:grid-cols-[120px_1fr] md:gap-7">
    <div>
      <p class="font-mono text-xs font-semibold uppercase tracking-[0.08em] text-[var(--accent)]">{d.venue}</p>
      <p class="mt-1 text-xs text-[var(--muted)]">{d.year} · {d.status}</p>
    </div>
    <div>
      <h3 class:list={[
        'font-serif font-semibold leading-tight text-[var(--text)] transition group-hover:text-[var(--accent)]',
        compact ? 'text-2xl' : 'text-2xl sm:text-3xl'
      ]}>{d.title}</h3>
      <p class="mt-3 text-sm text-[var(--muted)]">
        {d.authors.map((author, index) => (
          <>
            {author === 'Tongxi Wang' ? <strong class="font-semibold text-[var(--text)]">{author}</strong> : author}
            {index < d.authors.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
      <p class="mt-3 max-w-3xl leading-relaxed text-[var(--text)]">{tldr}</p>
      {!compact && (
        <ul class="mt-4 max-w-3xl list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-[var(--muted)]">
          {contributions.map((item) => <li>{item}</li>)}
        </ul>
      )}
      {!compact && (
        <p class="mt-4 text-xs font-medium text-[var(--muted)]">{d.tags.slice(0, 3).join(' · ')}</p>
      )}
      {validLinks.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-4 text-sm font-semibold text-[var(--accent)]">
          {validLinks.map(([label, href]) => <a href={href} class="hover:underline">{label === 'arxiv' ? 'arXiv ↗' : `${label.toUpperCase()} ↗`}</a>)}
        </div>
      )}
      {!compact && d.bibtex && (
        <details class="mt-5 rounded-md border border-[var(--line)] p-3 text-sm text-[var(--muted)]">
          <summary class="cursor-pointer font-semibold text-[var(--text)]">BibTeX</summary>
          <pre class="mt-3 overflow-x-auto text-xs">{d.bibtex}</pre>
        </details>
      )}
    </div>
  </div>
</article>
