---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '@/data/profile';
import type { Lang } from '@/data/navigation';
interface Props { pub: CollectionEntry<'publications'>; compact?: boolean; lang?: Lang }
const { pub: { data: d }, compact = false, lang = 'en' } = Astro.props;
const zh = lang === 'zh';
const labels = { arxiv: 'arXiv', pdf: 'PDF', code: zh ? '代码' : 'Code', project: zh ? '项目' : 'Project', demo: zh ? '演示' : 'Demo' };
const resources = Object.entries(labels).flatMap(([key, label]) => {
  const href = d.links[key];
  return href && !href.startsWith('#todo') ? [{ key, label, href }] : [];
});
const paperUrl = resources.find(link => link.key === 'arxiv' || link.key === 'pdf')?.href;
const venue = d.venue.includes(String(d.year)) ? d.venue : `${d.venue}, ${d.year}`;
const contributions = zh ? d.contributionsZh ?? d.contributions : d.contributions;
---
<article class:list={['citation', { full: !compact }]}>
  <h3>{paperUrl ? <a href={paperUrl}>{d.title}</a> : d.title}</h3>
  <p class="authors">{d.authors.map((name, i) => <>{i > 0 && ', '}{name === siteConfig.name ? <strong>{name}</strong> : name}</>)}</p>
  <p class="publication-line">
    <cite>{venue}</cite>
    {!compact && <span>{d.status}</span>}
    {resources.map(link => <a class="text-link" href={link.href}>{link.label}</a>)}
  </p>
  {!compact && <>
    <p class="abstract">{zh ? d.tldrZh ?? d.tldr : d.tldr}</p>
    <ul>{contributions.map(item => <li>{item}</li>)}</ul>
    {d.tags.length > 0 && <p class="tags">{d.tags.slice(0, 3).join(' · ')}</p>}
    {d.bibtex && <details><summary>BibTeX</summary><pre>{d.bibtex}</pre></details>}
  </>}
</article>
<style>
  .citation + .citation {margin-top:1.55rem}
  h3 {font-family:var(--serif); font-weight:600; font-size:1.18rem; line-height:1.45}
  h3 a:hover {color:var(--accent); text-decoration:underline; text-underline-offset:.17em}
  .authors, .publication-line, .tags {font-size:.89rem; line-height:1.6; color:var(--muted)}
  .authors {margin:.2rem 0 .12rem}
  strong {color:var(--text); font-weight:550}
  .publication-line {display:flex; align-items:baseline; flex-wrap:wrap; gap:.15rem .85rem}
  cite {font-family:var(--serif); font-size:1rem}
  .full {padding-bottom:1.65rem; border-bottom:1px solid var(--line)}
  .abstract {margin-top:.75rem}
  ul {padding-left:1.25rem; margin:.5rem 0; list-style:disc; color:var(--muted); font-size:.94rem}
  details {margin-top:.75rem; font-size:.86rem}
  summary {color:var(--accent); cursor:pointer}
  pre {overflow-x:auto; padding:.75rem 0; max-width:100%}
</style>
