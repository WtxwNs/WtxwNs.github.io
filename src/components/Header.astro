---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';
import Monogram from './Monogram.astro';
import { copy, siteConfig } from '@/data/profile';
import { localizedPath, navItems, type Lang } from '@/data/navigation';

interface Props { lang: Lang; pathname: string }
const { lang, pathname } = Astro.props;
const zh = lang === 'zh';
const home = localizedPath(lang);
const links = [
  { href: home, label: zh ? '首页' : 'Home' },
  ...navItems.map(item => ({ href: localizedPath(lang, item.href), label: copy[lang].nav[item.key] }))
];
const current = pathname.replace(/\/$/, '');
---
<header class="site-nav">
  <a class="signature" href={home} aria-label={zh ? `${siteConfig.nameZh}首页` : `${siteConfig.name} home`}>
    <Monogram compact />
    <span>{zh ? siteConfig.nameZh : siteConfig.name}</span>
  </a>
  <nav id="mobile-nav" aria-label={zh ? '主导航' : 'Main navigation'}>
    {links.map(({ href, label }) => <a href={href} aria-current={
      current === href ? 'page' : (href !== home && current.startsWith(href + '/') ? 'location' : undefined)
    }>{label}</a>)}
  </nav>
  <div class="options">
    <LanguageToggle lang={lang} pathname={pathname} />
    <ThemeToggle lang={lang} />
    <button type="button" class="menu" data-mobile-menu-button aria-controls="mobile-nav"
      aria-expanded="false" aria-label={zh ? '导航菜单' : 'Navigation menu'} title={zh ? '导航菜单' : 'Navigation menu'}>
      <span aria-hidden="true">☰</span>
    </button>
  </div>
</header>
<style>
  .site-nav {position:sticky; top:2.5rem; align-self:start}
  .signature {display:inline-flex; align-items:center; color:var(--text)}
  .signature span, .menu {display:none}
  nav {margin:1.8rem 0 1.6rem; display:grid; justify-items:start; gap:.25rem}
  nav a {display:inline-flex; align-items:center; min-height:2rem; color:var(--muted); font-size:.94rem}
  nav a[aria-current] {color:var(--text); font-weight:600; text-decoration:underline; text-underline-offset:.4em; text-decoration-thickness:1px}
  nav a:hover {color:var(--text); text-decoration:underline; text-underline-offset:.4em}
  .options {display:flex; align-items:center; gap:.35rem}
  @media(max-width:799px) {
    .site-nav {position:static; display:grid; grid-template-columns:1fr auto; align-items:center; padding-bottom:.5rem; border-bottom:1px solid var(--line)}
    .signature {gap:.45rem; justify-self:start}
    .signature span {display:inline; font-family:var(--serif); font-size:1.05rem}
    nav {display:none; grid-column:1/-1; grid-row:2; margin:.5rem 0 0; padding-block:.5rem; border-top:1px solid var(--line)}
    nav[data-open] {display:flex; flex-wrap:wrap; gap:.25rem 1.2rem}
    .options {grid-column:2; grid-row:1}
    .menu {display:grid; place-items:center; width:2.5rem; height:2.5rem; color:var(--muted)}
  }
  @media(max-width:799px) and (scripting:none) {nav {display:flex; flex-wrap:wrap; gap:1rem} .menu {display:none}}
</style>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-mobile-menu-button]')!;
  const menu = document.querySelector<HTMLElement>('#mobile-nav')!;
  const setOpen = (open: boolean) => {
    menu.toggleAttribute('data-open', open);
    button.setAttribute('aria-expanded', String(open));
  };
  button.addEventListener('click', () => setOpen(!menu.hasAttribute('data-open')));
  menu.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu.hasAttribute('data-open')) {
      setOpen(false);
      button.focus();
    }
  });
</script>
