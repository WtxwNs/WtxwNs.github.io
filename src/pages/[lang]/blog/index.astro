---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import BlogCard from '@/components/BlogCard.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import type { Lang } from '@/data/navigation';
export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }]; }
const lang = Astro.params.lang as Lang;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === lang)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout lang={lang} title={lang === 'zh' ? '写作' : 'Writing'}>
  <section class="py-10">
    <SectionTitle
      eyebrow="Writing"
      title={lang === 'zh' ? '研究笔记与思考' : 'Research notes and essays'}
      description={lang === 'zh' ? '记录论文阅读、研究判断和工程实践中值得保留的想法。' : 'Notes on papers, research judgment, and ideas worth preserving from engineering practice.'}
    />
  </section>
  <div class="grid gap-4 md:grid-cols-2">
    {posts.map((post) => <BlogCard post={post} lang={lang} />)}
  </div>
</Layout>
