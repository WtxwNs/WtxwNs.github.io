---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import EditorialHomeZh from '@/components/EditorialHomeZh.astro';
import HeroProfile from '@/components/HeroProfile.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import ResearchTrackCard from '@/components/ResearchTrackCard.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import BlogCard from '@/components/BlogCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { interests, news } from '@/data/profile';
import type { Lang } from '@/data/navigation';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const pubs = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const highlighted = pubs.filter((p) => p.data.highlight).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

{
  lang === 'zh' ? (
    <EditorialHomeZh />
  ) : (
    <Layout lang={lang} title="Home">
      <HeroProfile lang={lang} />

      <section class="py-12" id="research">
        <SectionTitle
          eyebrow="Research agenda"
          title="Three questions that connect my work"
          description="The applications change; the recurring questions concern feedback, computation, and reliability."
        />
        <div class="grid gap-x-8 lg:grid-cols-3">
          {interests.map((item) => <ResearchTrackCard {...item} lang={lang} />)}
        </div>
      </section>

      <section class="py-12">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <SectionTitle
            eyebrow="Selected research"
            title="Selected work"
            description="Each project starts from a concrete question and aims for a testable central claim."
          />
          <a href={`/${lang}/publications`} class="mb-6 text-sm font-semibold text-[var(--accent)] hover:underline">
            All publications →
          </a>
        </div>
        <div>{highlighted.map((pub) => <PublicationCard pub={pub} compact lang={lang} />)}</div>
      </section>

      <section class="py-12">
        <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <SectionTitle
            eyebrow="Selected systems"
            title="From theory to physical systems"
            description="Robotics, medical AI, and embedded systems ground my research in real constraints."
          />
          <a href={`/${lang}/projects`} class="mb-6 text-sm font-semibold text-[var(--accent)] hover:underline">
            All systems work →
          </a>
        </div>
        <div class="grid gap-7 md:grid-cols-3">
          {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
        </div>
      </section>

      <section class="grid gap-10 py-12 lg:grid-cols-[0.85fr_1.15fr]">
        <div>
          <SectionTitle eyebrow="Updates" title="News" />
          <ol class="border-t border-[var(--line)]">
            {
              news.map((item) => (
                <li class="grid grid-cols-[76px_1fr] gap-3 border-b border-[var(--line)] py-4 text-sm">
                  <time class="font-mono text-xs font-semibold text-[var(--accent)]">{item.date}</time>
                  <a href={item.hrefEn} class="text-[var(--muted)] hover:text-[var(--text)]">
                    {item.en}
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
        <div>
          <div class="flex items-end justify-between gap-4">
            <SectionTitle eyebrow="Writing" title="Recent writing" />
            <a href={`/${lang}/blog`} class="mb-6 text-sm font-semibold text-[var(--accent)] hover:underline">
              All writing →
            </a>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {posts.map((post) => <BlogCard post={post} lang={lang} />)}
          </div>
        </div>
      </section>
    </Layout>
  )
}
