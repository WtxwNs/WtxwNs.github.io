---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SocialLinks from '@/components/SocialLinks.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import BlogCard from '@/components/BlogCard.astro';
import { interests, news, siteConfig as profile } from '@/data/profile';
import type { Lang } from '@/data/navigation';

export function getStaticPaths() {
  return ['en', 'zh'].map(lang => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const zh = lang === 'zh';
const publications = (await getCollection('publications', ({ data }) => data.highlight))
  .sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const systems = zh ? profile.systemsZh : (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ data }) => ({ title: data.title, description: data.description, area: data.area, href: '/en/projects/' }));
---
<Layout lang={lang} title={zh ? '首页' : 'Home'}>
  <div class="home" id="top">
    <section class="introduction" aria-labelledby="name">
      {profile.portrait && <img class="portrait" src={profile.portrait} alt={zh ? profile.nameZh : profile.name} width="96" height="112" />}
      <h1 id="name">{zh ? profile.nameZh : profile.name}
        <small lang={zh ? 'en' : 'zh'}>{zh ? profile.name : profile.nameZh}</small>
      </h1>
      <p class="affiliation">{zh ? profile.institutionZh : profile.institution} · {zh ? profile.locationZh : profile.location}</p>
      <div class="biography">
        <p>{zh ? profile.taglineZh : profile.tagline}</p>
        <p>{zh ? profile.introZh : profile.intro}</p>
      </div>
      <SocialLinks lang={lang} />
    </section>
    <section id="publications">
      <div class="section-heading"><h2>{zh ? '代表论文' : 'Selected publications'}</h2><a href={`/${lang}/publications/`}>{zh ? '全部论文' : 'All publications'}</a></div>
      {publications.map(pub => <PublicationCard pub={pub} lang={lang} compact />)}
    </section>
    <section id="writing">
      <div class="section-heading"><h2>{zh ? '近期写作' : 'Recent writing'}</h2><a href={`/${lang}/blog/`}>{zh ? '全部文章' : 'All writing'}</a></div>
      {posts.map(post => <BlogCard post={post} lang={lang} compact />)}
      {!posts.length && <p>{zh ? '暂无已发表的文章。' : 'No published posts yet.'}</p>}
    </section>
    <section id="research">
      <div class="section-heading"><h2>{zh ? '研究方向' : 'Research interests'}</h2><a href={`/${lang}/academic/`}>{zh ? '研究详情' : 'Research profile'}</a></div>
      <dl class="research-list">{interests.map(item => <div>
        <dt>{zh ? item.titleZh : item.title}</dt><dd>{zh ? item.questionZh : item.question}</dd>
      </div>)}</dl>
    </section>
    <section id="systems">
      <div class="section-heading"><h2>{zh ? '研究项目' : 'Projects'}</h2><a href={`/${lang}/projects/`}>{zh ? '全部项目' : 'All projects'}</a></div>
      {systems.map(system => <article class="project">
        <h3><a href={system.href}>{system.title}</a></h3>
        {system.area && <span>{system.area}</span>}
        <p>{system.description}</p>
      </article>)}
    </section>
    {!zh && <section>
      <div class="section-heading"><h2>News</h2></div>
      {news.map(item => <p class="news"><time>{item.date}</time><a href={item.hrefEn}>{item.en}</a></p>)}
    </section>}
  </div>
</Layout>
<style>
  .home section + section {margin-top:3rem}
  .introduction {display:flow-root}
  h1, h2, .project h3 {font-family:var(--serif)}
  h1 {display:flex; align-items:baseline; flex-wrap:wrap; gap:.2rem .9rem; font-size:2.65rem; font-weight:500; line-height:1.2}
  h1 small {font-size:1.35rem; color:var(--muted); font-weight:400}
  h1 small[lang=en] {font-style:italic}
  .affiliation {margin-top:.5rem; font-size:.92rem; color:var(--muted)}
  .biography {margin:1.35rem 0 1rem; max-width:68ch; font-size:1.055rem; line-height:1.85}
  .biography p + p {margin-top:.3rem}
  .portrait {float:right; margin:0 0 1rem 1.25rem; width:6rem; height:7rem; object-fit:cover}
  .section-heading {display:flex; align-items:baseline; flex-wrap:wrap; justify-content:space-between; gap:.25rem 1rem; padding-bottom:.55rem; margin-bottom:1.2rem; border-bottom:1px solid var(--line)}
  h2 {font-size:1.45rem; font-weight:600; line-height:1.4}
  .section-heading a, .project span, .news time {font-size:.84rem; color:var(--muted)}
  a:hover {color:var(--accent); text-decoration:underline; text-underline-offset:.2em}
  .research-list > div, .news {display:grid; grid-template-columns:9rem minmax(0,1fr); gap:1rem; align-items:baseline; margin-bottom:.75rem}
  dt {font-weight:550}
  dd, .project p {color:var(--muted); font-size:.96rem; line-height:1.75}
  .project + .project {margin-top:1.3rem}
  .project h3, .project span {display:inline; margin-right:.75rem}
  .project h3 {font-size:1.17rem; font-weight:600}
  .project p {margin-top:.25rem}
  .news {grid-template-columns:5rem minmax(0,1fr)}
  @media(max-width:540px) {
    h1 {font-size:2.15rem}
    h1 small {font-size:1.15rem}
    .biography {font-size:1rem}
    .portrait {width:4.4rem; height:5.2rem; margin-left:.85rem}
    .home section + section {margin-top:2.25rem}
    .research-list > div {display:block; margin-bottom:1rem}
  }
</style>
