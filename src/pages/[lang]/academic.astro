---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import InterestCard from '@/components/InterestCard.astro';
import PublicationCard from '@/components/PublicationCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Timeline from '@/components/Timeline.astro';
import { coursework, education, honors, honorsZh, interests } from '@/data/profile';
import type { Lang } from '@/data/navigation';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang as Lang;
const pubs = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Layout lang={lang} title={lang === 'zh' ? '学术' : 'Academic'}>
  <section class="py-8">
    <SectionTitle
      title={lang === 'zh' ? '学术主页' : 'Academic Profile'}
      description={lang === 'zh' ? '研究兴趣、论文、项目与服务的集中入口。' : 'A compact view of research interests, publications, projects, and service.'}
    />
    <p class="max-w-3xl text-[var(--muted)]">
      {lang === 'zh'
        ? '王童曦目前就读于东南大学未来技术学院，研究强化学习理论、多智能体系统、高效大语言模型与可靠上下文学习。'
        : 'Tongxi Wang is an undergraduate researcher at the School of Future Technology, Southeast University, working on reinforcement learning theory, multi-agent systems, efficient LLMs, and reliable in-context learning.'}
    </p>
    <a class="mt-5 inline-flex rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-white" href={`/${lang}/cv`}>
      {lang === 'zh' ? '查看网页版简历' : 'View Web CV'}
    </a>
  </section>

  <section class="py-8">
    <SectionTitle title={lang === 'zh' ? '研究兴趣' : 'Research Interests'} />
    <div class="grid gap-4 md:grid-cols-2">{interests.map((item) => <InterestCard {...item} lang={lang} />)}</div>
  </section>

  <section class="py-8">
    <SectionTitle title={lang === 'zh' ? '论文与预印本' : 'Selected Publications'} />
    <div class="space-y-4">{pubs.map((pub) => <PublicationCard pub={pub} lang={lang} />)}</div>
  </section>

  <section class="py-8">
    <SectionTitle title={lang === 'zh' ? '研究项目' : 'Research Projects'} />
    <div class="grid gap-5 md:grid-cols-3">{projects.map((project) => <ProjectCard project={project} lang={lang} />)}</div>
  </section>

  <section class="grid gap-8 py-8 lg:grid-cols-2">
    <div>
      <SectionTitle title={lang === 'zh' ? '教育经历' : 'Education'} />
      <Timeline items={education} lang={lang} />
    </div>
    <div>
      <SectionTitle title={lang === 'zh' ? '课程' : 'Coursework'} />
      <p class="text-sm text-[var(--muted)]">{coursework.join(' · ')}</p>
    </div>
  </section>

  <section class="py-8">
    <SectionTitle title={lang === 'zh' ? '荣誉与服务' : 'Honors & Service'} />
    <ul class="space-y-3 rounded-lg border border-[var(--line)] bg-[var(--panel)] p-5 text-sm text-[var(--muted)]">
      {(lang === 'zh' ? honorsZh : honors).map((item) => <li>{item}</li>)}
    </ul>
  </section>
</Layout>
