---
import Layout from '@/layouts/Layout.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import { siteConfig } from '@/data/profile';
import type { Lang } from '@/data/navigation';
export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }]; }
const lang = Astro.params.lang as Lang;
---
<Layout lang={lang} title={lang === 'zh' ? '关于' : 'About'}>
  <section class="max-w-3xl py-10">
    <SectionTitle
      eyebrow="About"
      title={lang === 'zh' ? '从机器人系统走向学习理论' : 'From robotic systems to learning theory'}
      description={lang === 'zh' ? '工程背景让我关心算法在噪声、反馈与有限计算下究竟如何工作。' : 'An engineering background keeps me interested in how algorithms behave under noise, feedback, and limited computation.'}
    />
  </section>
  <div class="content-prose pb-12 text-[var(--muted)]">
    {lang === 'zh' ? (
      <>
        <p>我目前就读于东南大学未来技术学院，最初的训练来自机器人、控制与嵌入式系统。真实系统中的感知噪声、接触反馈和计算限制，逐渐把我的注意力引向更基础的问题：学习算法为何稳定，何时能够适应变化，又该如何分配有限计算。</p>
        <p>现在的工作主要围绕强化学习、多智能体学习与高效语言模型展开。我倾向于先找到控制问题行为的数学结构，再判断它能否形成更清楚的理论边界或更有效的算法。</p>
        <p>我也会在这里记录论文阅读、尚未成熟的研究判断和工程经验。</p>
      </>
    ) : (
      <>
        <p>I am an undergraduate at the School of Future Technology, Southeast University. My early training came from robotics, control, and embedded systems. Sensing noise, contact feedback, and limited compute in physical systems gradually led me to more basic questions: why a learning algorithm is stable, when it can adapt to change, and how it should allocate computation.</p>
        <p>My current work spans reinforcement learning, multi-agent learning, and efficient language models. I usually begin by identifying the mathematical structure that controls behavior, then ask whether it yields a clearer boundary or a more effective algorithm.</p>
        <p>This site also holds paper notes, research judgments in progress, and lessons from engineering work.</p>
      </>
    )}
    <h2>{lang === 'zh' ? '联系' : 'Contact'}</h2>
    <p>Email: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.</p>
  </div>
</Layout>
