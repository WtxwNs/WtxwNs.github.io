---
import '@/styles/global.css';
import { siteConfig } from '@/data/profile';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" /><title>内容管理 | {siteConfig.nameZh}</title>
  </head>
  <body>
    <main class="mx-auto max-w-2xl px-5 py-10">
      <a class="text-sm text-[var(--muted)]" href="/zh/">← 返回主页</a>
      <h1 class="my-6 font-serif text-3xl font-semibold">内容管理</h1>
      <nav aria-label="编辑内容">
        <a href="/admin/index.html#/collections/profile/entries/home">修改首页资料 <span>→</span></a>
        <a href="/admin/index.html#/collections/profile/entries/academic">研究方向与荣誉 <span>→</span></a>
        <a href="/admin/index.html#/collections/blog/new">撰写博客 <span>→</span></a>
        <a href="/admin/index.html#/collections/blog">编辑已有文章 <span>→</span></a>
        <a href="/admin/index.html#/collections/publications">管理论文 <span>→</span></a>
        <a href="/admin/index.html#/collections/projects">管理项目 <span>→</span></a>
        <a href="/admin/index.html">打开完整后台 <span>→</span></a>
      </nav>
      <section class="my-8">
        <h2 class="font-serif text-xl font-semibold">导入 Markdown 文稿</h2>
        <label for="manuscript" class="my-2 block text-sm text-[var(--muted)]">选择 .md 文件，检查标题、摘要与正文后保存。</label>
        <input type="file" id="manuscript" accept=".md,.markdown,text/markdown" />
        <p role="alert" id="error"></p>
      </section>
      <p class="text-sm leading-relaxed text-[var(--muted)]">首次在线编辑时，选择使用 GitHub 令牌登录。发表博客时关闭“保存为草稿”。保存后可查看<a href="https://github.com/WtxwNs/WtxwNs.github.io/actions/workflows/deploy.yml" class="underline">发布进度</a>。</p>
    </main>
    <script>
      import matter from 'front-matter';
      const input = document.querySelector<HTMLInputElement>('#manuscript')!;
      const error = document.querySelector<HTMLElement>('#error')!;
      input.addEventListener('change', async () => {
        const file = input.files?.[0];
        if (!file) return;
        error.textContent = '';
        try {
          const { attributes, body } = matter<Record<string, unknown>>(await file.text());
          const title = typeof attributes.title === 'string' ? attributes.title : file.name.replace(/\.(md|markdown)$/i, '');
          const fields = new URLSearchParams({ title, body, draft: 'true' });
          for (const key of ['lang', 'category', 'description']) {
            if (typeof attributes[key] === 'string') fields.set(key, attributes[key]);
          }
          if (attributes.date instanceof Date) fields.set('date', attributes.date.toISOString().slice(0, 10));
          else if (typeof attributes.date === 'string') fields.set('date', attributes.date);
          if (Array.isArray(attributes.tags)) for (const tag of attributes.tags) fields.append('tags', String(tag));
          location.assign('/admin/index.html#/collections/blog/new?' + fields);
        } catch (cause) {
          error.textContent = cause instanceof Error ? cause.message : String(cause);
        }
      });
    </script>
  </body>
</html>
<style>
  nav a {display: flex; justify-content: space-between; align-items: center; padding: .9rem 0; border-bottom: 1px solid var(--line)}
  a:hover, nav span {color: var(--accent)}
  input {max-width: 100%; font-size: .9rem}
  input::file-selector-button {padding: .55rem .85rem; border: 1px solid var(--line); border-radius: 4px; background: var(--panel); cursor: pointer}
  #error {color: #a13b30; overflow-wrap: anywhere}
</style>
